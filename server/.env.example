# Local development defaults only. Replace every secret before deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-dev-change-this-password
# DATA_KEY must be Base64 encoding of exactly 32 random raw bytes.
# Generate with: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DATA_KEY=REPLACE_WITH_BASE64_OF_32_BYTES
# PIN_PEPPER is an independent, long, random secret string; keep it private and stable.
# Example generation: python -c "import secrets;print(secrets.token_urlsafe(48))"
PIN_PEPPER=REPLACE_WITH_LONG_RANDOM_PIN_PEPPER
APP_VERSION=1.3.0
ENABLE_API_DOCS=true
ALERT_WEBHOOK_URL=
DATABASE_URL=sqlite:///./mgroup.db

# WebUI session cookie
SESSION_COOKIE_NAME=mg_admin_session
SECURE_COOKIES=false

# Login rate limiting
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
