# Local development defaults only. Replace every secret before deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-dev-change-this-password
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DATA_KEY=CHANGE_ME_BASE64_OF_32_RANDOM_BYTES
PIN_PEPPER=local-development-pin-pepper-change-me
APP_VERSION=1.3.0
ENABLE_API_DOCS=true
ALERT_WEBHOOK_URL=
DATABASE_URL=sqlite:///./mgroup.db
